# systemd USER service: the background worker that renders reels, one at a time.
# deploy/install-services.sh fills in the folder and the limits from buzz.env; edit buzz.env, not this file.
# Enable lingering once so it keeps running after logout:  sudo loginctl enable-linger $USER
[Unit]
Description=Buzz worker (renders reels)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/buzz.env
ExecStart=/bin/bash @ROOT@/buzzctl.sh run-worker
Restart=always
RestartSec=5
# keep rendering from starving other sites on the same machine
Nice=10
IOSchedulingClass=idle
CPUQuota=@CPU_QUOTA@
MemoryHigh=@WORKER_MEMORY_HIGH@
MemoryMax=@WORKER_MEMORY@
# if the memory cap is hit, the worker restarts and the interrupted reel resumes from its last finished step
OOMPolicy=stop

[Install]
WantedBy=default.target
