# systemd USER service: the web page, bound to localhost only (nginx is the public door).
# deploy/install-services.sh fills in the folder and the limits from buzz.env; edit buzz.env, not this file.
[Unit]
Description=Buzz web page
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT@
EnvironmentFile=-@ROOT@/buzz.env
ExecStart=/bin/bash @ROOT@/buzzctl.sh run-web
Restart=always
RestartSec=5
Nice=5
MemoryHigh=@WEB_MEMORY_HIGH@
MemoryMax=@WEB_MEMORY@

[Install]
WantedBy=default.target
