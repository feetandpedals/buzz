# Buzz server settings. setup.sh copies this file to buzz.env (which stays out of git); edit buzz.env, then run
#   ./buzzctl.sh restart
# One setting per line, NAME=value, no spaces around "=". Comments go on their own line.

# Where the web page listens. Keep 127.0.0.1 and put nginx in front (deploy/nginx-buzz.conf).
BUZZ_HOST=127.0.0.1
BUZZ_PORT=8501

# Largest upload in MB (keep nginx client_max_body_size at least this big).
BUZZ_MAX_UPLOAD_MB=1500

# Shared-hosting limits. Reels are made one at a time; these keep one reel from crowding out other sites.
# CPU threads one reel may use (video encoding, free voice, music analysis).
BUZZ_THREADS=2
# Hard memory caps (systemd). A 30-second voiced reel peaks around 1.5 GB in the worker.
BUZZ_WORKER_MEMORY=3G
BUZZ_WEB_MEMORY=1G
# CPU cap for the worker: 100% = one full core.
BUZZ_CPU_QUOTA=200%

# Optional. Encrypted keys live in ~/.config/buzz unless moved here.
#BUZZ_SECRETS_DIR=
# Optional. Supply the master key here instead of the key file (a Fernet key).
#BUZZ_MASTER_KEY=
# Optional. A Claude key for the whole studio, instead of saving it on the Settings tab.
#BUZZ_ANTHROPIC=
# Optional. Send Claude requests through a gateway instead of api.anthropic.com.
#BUZZ_CLAUDE_URL=
